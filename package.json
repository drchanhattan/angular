{
  "name": "website",
  "version": "0.0.0",
  "scripts": {
    "locate-circular-deps": "npx madge --circular --extensions ts ./",
    "prettier": "npx prettier --write \"**/*.ts\" \"**/*.html\"",
    "lint": "eslint \"src/**/*.ts\"",
    "build": "ng build --configuration production --output-path docs --base-href .",
    "serve": "ng serve",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint"
    ],
    "**/*.html": "prettier --write"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@ngrx/signals": "^22.0.1",
    "aos": "^2.3.4",
    "firebase": "^13.1.0",
    "obscenity": "^0.4.6",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/aos": "^3.0.8",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "istanbul-lib-instrument": "^6.0.3",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3"
  }
}
